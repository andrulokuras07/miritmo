# Copia este archivo como "despliegue.env" y llena los valores.
# despliegue.env NUNCA se sube a GitHub (está en .gitignore).

# Credencial de servicio de IBM Cloudant (IBM Cloud -> tu instancia -> Service credentials)
CLOUDANT_URL=
CLOUDANT_APIKEY=

# Región de AWS (Ohio)
AWS_REGION=us-east-2

# Opcionales
# BUCKET=miritmo-web-equipo        Por defecto: miritmo-web-<id-de-tu-cuenta>
# LAMBDA_ROLE_ARN=                 Solo si tu cuenta no permite crear roles (ej. AWS Academy: ARN de LabRole)
# TOKEN_SECRET se genera solo en el primer despliegue.

{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "SoloCloudFront",
    "Effect": "Allow",
    "Principal": { "Service": "cloudfront.amazonaws.com" },
    "Action": "s3:GetObject",
    "Resource": "arn:aws:s3:::__BUCKET__/*",
    "Condition": { "StringEquals": { "AWS:SourceArn": "arn:aws:cloudfront::__CUENTA__:distribution/__DISTRIBUCION__" } }
  }]
}
